#!/usr/bin/env bash
set -euo pipefail

# ticket - minimal ticket system with dependency tracking
# Stores markdown files with YAML frontmatter in .tickets/

# Find .tickets directory by walking parent directories
find_tickets_dir() {
    # Explicit env var takes priority
    [[ -n "${TICKETS_DIR:-}" ]] && { echo "$TICKETS_DIR"; return 0; }

    # Walk parents looking for .tickets
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.tickets" ]]; then
            echo "$dir/.tickets"
            return 0
        fi
        dir=$(dirname "$dir")
    done

    # Check root too
    [[ -d "/.tickets" ]] && { echo "/.tickets"; return 0; }

    # Not found
    return 1
}

# Commands that can create .tickets if not found
WRITE_COMMANDS="create"

# Initialize TICKETS_DIR based on command type
init_tickets_dir() {
    local cmd="$1"
    local is_write_cmd=0
    [[ " $WRITE_COMMANDS " == *" $cmd "* ]] && is_write_cmd=1

    if TICKETS_DIR=$(find_tickets_dir); then
        # For read commands, verify the directory exists
        if [[ $is_write_cmd -eq 0 ]] && [[ ! -d "$TICKETS_DIR" ]]; then
            echo "Error: tickets directory '$TICKETS_DIR' does not exist" >&2
            return 1
        fi
        return 0
    fi

    # Not found - write commands can initialize in current directory
    if [[ $is_write_cmd -eq 1 ]]; then
        TICKETS_DIR=".tickets"
        return 0
    fi

    echo "Error: no .tickets directory found (searched parent directories)" >&2
    echo "Run 'tk create' to initialize, or set TICKETS_DIR env var" >&2
    return 1
}

TICKET_PAGER="${TICKET_PAGER:-${PAGER:-}}"

# Prefer ripgrep if available, fall back to grep
if command -v rg &>/dev/null; then
    _grep() { rg "$@"; }
else
    _grep() { grep "$@"; }
fi

# Portable ISO date (GNU date supports -Iseconds, BSD date does not)
_iso_date() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

# Strip terminal line breaks so the writer controls the final newline.
_strip_trailing_newlines() {
    local value="$1"
    while [[ "$value" == *$'\n' ]]; do
        value="${value%$'\n'}"
        [[ "$value" == *$'\r' ]] && value="${value%$'\r'}"
    done
    printf '%s' "$value"
}

# Read files (or stdin with no arguments) without terminal line breaks.
# $(cat) alone stops stripping at a CR, stranding it.
_read_stripped() {
    local content
    content=$(cat -- "$@" && printf x) || return 1
    _strip_trailing_newlines "${content%x}"
}

# Generate ticket ID from directory name + random string
generate_id() {
    local dir_name
    dir_name=$(basename "$(pwd)")

    # Extract first letter of each hyphenated/underscored segment
    local prefix
    prefix=$(echo "$dir_name" | sed 's/[-_]/ /g' | awk '{for(i=1;i<=NF;i++) printf substr($i,1,1)}')

    # Fallback to first 3 chars if single segment (prefix too short)
    [[ ${#prefix} -lt 2 ]] && prefix="${dir_name:0:3}"

    # 4-char random lower case alphanumeric string
    local hash
    hash=$(LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom | head -c 4)

    echo "${prefix}-${hash}"
}

# Ensure tickets directory exists
ensure_dir() {
    mkdir -p "$TICKETS_DIR"
}

# Succeed if the tickets directory holds at least one ticket. Bulk readers
# check this first: with no match, "$TICKETS_DIR"/*.md stays a literal glob
# that awk and ls fail to open. The directory part is quoted so brackets or
# other glob characters in the path match literally.
_have_tickets() {
    local f
    for f in "$TICKETS_DIR"/*.md; do
        [[ -e "$f" ]] && return 0
    done
    return 1
}

# Fail with an error unless an option that takes a value has one.
# Usage: _require_value <option> <number of remaining arguments>
_require_value() {
    if [[ "$2" -lt 2 ]]; then
        echo "Error: $1 requires a value" >&2
        return 1
    fi
}

# Get ticket file path (supports partial ID matching)
ticket_path() {
    local id="$1"
    # Trim leading/trailing whitespace (handles Claude/agent quirks)
    read -r id <<< "$id"
    local exact="$TICKETS_DIR/${id}.md"

    if [[ -f "$exact" ]]; then
        echo "$exact"
        return 0
    fi

    # Try partial match (anywhere in filename)
    local matches
    matches=$(find "$TICKETS_DIR" -maxdepth 1 -name "*${id}*.md" 2>/dev/null | head -2)
    local count
    count=$(echo "$matches" | _grep -c . || true)

    if [[ "$count" -eq 1 ]]; then
        echo "$matches"
        return 0
    elif [[ "$count" -gt 1 ]]; then
        echo "Error: ambiguous ID '$id' matches multiple tickets" >&2
        return 1
    else
        echo "Error: ticket '$id' not found" >&2
        return 1
    fi
}

# Frontmatter is the block from a "---" on line 1 to the next "---" line.
# Every reader and writer below looks only inside that block, so body text
# (including "---" rules and lines like "status: x") is never parsed or
# rewritten.

# Print a frontmatter field's value; return 1 if the field is absent.
yaml_field() {
    local file="$1"
    local field="$2"
    YAML_FIELD="$field" awk '
    BEGIN { prefix = ENVIRON["YAML_FIELD"] ":" }
    NR == 1 { if ($0 != "---") exit; next }
    $0 == "---" { exit }
    index($0, prefix) == 1 {
        value = substr($0, length(prefix) + 1)
        sub(/^ */, "", value)
        print value
        found = 1
        exit
    }
    END { exit found ? 0 : 1 }
    ' "$file"
}

# Rewrite or check a ticket's frontmatter in one portable awk pass.
#   mode:    "write" rewrites the file; "check" only validates it
#   remove:  space-separated field names to drop
#   field:   field to set in place, or add right after the opening ---
#   value:   value for that field (passed via ENVIRON, so it stays literal)
#   prepend: lines to add right after the opening ---
# Fails with an error, leaving the file untouched, when there is no
# frontmatter to edit.
_edit_frontmatter() {
    local file="$1" mode="$2" remove="$3" field="$4" value="$5" prepend="$6"
    local out="${file}.tmp.$$" check=""
    if [[ "$mode" == check ]]; then
        out=/dev/null
        check=1
    fi

    local rc=0
    FM_CHECK="$check" FM_REMOVE="$remove" FM_FIELD="$field" FM_VALUE="$value" \
        FM_PREPEND="$prepend" awk '
    function key_of(text) {
        if (index(text, ":") == 0) return ""
        sub(/:.*/, "", text)
        return text
    }
    { line[NR] = $0 }
    END {
        if (line[1] == "---\r") exit 4
        if (line[1] != "---") exit 3
        for (close_at = 2; close_at <= NR && line[close_at] != "---"; close_at++) ;
        if (close_at > NR) exit 5
        if (ENVIRON["FM_CHECK"] == "1") exit 0

        count = split(ENVIRON["FM_REMOVE"], names, " ")
        for (i = 1; i <= count; i++) remove[names[i]] = 1
        field = ENVIRON["FM_FIELD"]
        field_line = field ": " ENVIRON["FM_VALUE"]
        has_field = 0
        for (i = 2; i < close_at; i++) if (field != "" && key_of(line[i]) == field) has_field = 1

        print line[1]
        if (ENVIRON["FM_PREPEND"] != "") print ENVIRON["FM_PREPEND"]
        if (field != "" && !has_field) print field_line
        for (i = 2; i < close_at; i++) {
            key = key_of(line[i])
            if (key != "" && (key in remove)) continue
            if (field != "" && key == field) print field_line
            else print line[i]
        }
        for (i = close_at; i <= NR; i++) print line[i]
    }
    ' "$file" > "$out" || rc=$?

    if [[ $rc -eq 0 ]]; then
        [[ "$out" == /dev/null ]] || mv "$out" "$file"
        return 0
    fi
    [[ "$out" == /dev/null ]] || rm -f "$out"
    case $rc in
        3) echo "Error: $file has no YAML frontmatter (line 1 is not ---)" >&2 ;;
        4) echo "Error: $file has CRLF line endings; convert it to LF to edit it" >&2 ;;
        5) echo "Error: $file frontmatter is not closed (no second --- line)" >&2 ;;
        *) echo "Error: could not update $file" >&2 ;;
    esac
    return 1
}

# Set a frontmatter field, adding it after the opening --- if absent.
update_yaml_field() {
    _edit_frontmatter "$1" write "" "$2" "$3" ""
}

# Remove frontmatter fields.
remove_yaml_fields() {
    local file="$1"
    shift
    _edit_frontmatter "$file" write "$*" "" "" ""
}

# Fail with an error unless the file has frontmatter that can be edited.
check_frontmatter() {
    _edit_frontmatter "$1" check "" "" "" ""
}

# Print the items of a flow-style YAML list such as "[a, b]", one per line.
_list_items() {
    local value="$1" item
    local -a items=()
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    value="${value#\[}"
    value="${value%\]}"
    IFS=',' read -r -a items <<< "$value"
    for item in "${items[@]+"${items[@]}"}"; do
        item="${item#"${item%%[![:space:]]*}"}"
        item="${item%"${item##*[![:space:]]}"}"
        if [[ -n "$item" ]]; then
            printf '%s\n' "$item"
        fi
    done
}

# Succeed if a YAML list contains an item exactly (no substring or regex match).
_list_has() {
    local item
    while IFS= read -r item; do
        [[ "$item" == "$2" ]] && return 0
    done < <(_list_items "$1")
    return 1
}

# Print a YAML list with an item appended.
_list_add() {
    local out="" item
    while IFS= read -r item; do
        out+="${out:+, }$item"
    done < <(_list_items "$1")
    out+="${out:+, }$2"
    printf '[%s]' "$out"
}

# Print a YAML list without any item equal to the given one.
_list_remove() {
    local out="" item
    while IFS= read -r item; do
        [[ "$item" == "$2" ]] && continue
        out+="${out:+, }$item"
    done < <(_list_items "$1")
    printf '[%s]' "$out"
}

_utc_today() {
    date -u +%F
}

validate_defer_date() {
    local value="$1"
    local year month day
    local year_num month_num day_num max_day

    if [[ ! "$value" =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2})$ ]]; then
        echo "Error: invalid defer date '$value' (expected YYYY-MM-DD)" >&2
        return 1
    fi

    year="${BASH_REMATCH[1]}"
    month="${BASH_REMATCH[2]}"
    day="${BASH_REMATCH[3]}"
    year_num=$((10#$year))
    month_num=$((10#$month))
    day_num=$((10#$day))

    if (( year_num < 1 || month_num < 1 || month_num > 12 || day_num < 1 )); then
        echo "Error: invalid defer date '$value' (expected a calendar date)" >&2
        return 1
    fi

    case "$month_num" in
        1|3|5|7|8|10|12) max_day=31 ;;
        4|6|9|11) max_day=30 ;;
        2)
            max_day=28
            if (( year_num % 400 == 0 || (year_num % 4 == 0 && year_num % 100 != 0) )); then
                max_day=29
            fi
            ;;
    esac

    if (( day_num > max_day )); then
        echo "Error: invalid defer date '$value' (expected a calendar date)" >&2
        return 1
    fi
}

write_deferral_metadata() {
    local file="$1"
    local until="$2"
    local reason="$3"

    # The reason becomes a YAML single-quoted scalar (apostrophes doubled)
    local q="'"
    local lines="deferred: true"
    [[ -n "$until" ]] && lines+=$'\n'"defer_until: $until"
    [[ -n "$reason" ]] && lines+=$'\n'"defer_reason: $q${reason//$q/$q$q}$q"

    _edit_frontmatter "$file" write "deferred defer_until defer_reason" "" "" "$lines"
}

cmd_create() {
    local title="" description="" design="" acceptance=""
    local description_file="" design_file="" acceptance_file="" inline_fields=""
    local priority=2 issue_type="task" assignee="" external_ref="" parent="" tags=""
    local dry_run=0

    # Default assignee to git user.name if available
    assignee=$(git config user.name 2>/dev/null || true)

    # Parse args
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--description) description="$2"; inline_fields+=" description"; shift 2 ;;
            --design) design="$2"; inline_fields+=" design"; shift 2 ;;
            --acceptance) acceptance="$2"; inline_fields+=" acceptance"; shift 2 ;;
            --description-file|--design-file|--acceptance-file)
                if [[ -z "${2:-}" ]]; then
                    echo "Error: $1 requires a path" >&2
                    return 1
                fi
                case "$1" in
                    --description-file) description_file="$2" ;;
                    --design-file) design_file="$2" ;;
                    --acceptance-file) acceptance_file="$2" ;;
                esac
                shift 2 ;;
            --dry-run) dry_run=1; shift ;;
            -h|--help) _command_help create; return 0 ;;
            -p|--priority) priority="$2"; shift 2 ;;
            -t|--type) issue_type="$2"; shift 2 ;;
            -a|--assignee) assignee="$2"; shift 2 ;;
            --external-ref) external_ref="$2"; shift 2 ;;
            --parent) parent="$2"; shift 2 ;;
            --tags) tags="$2"; shift 2 ;;
            -*) echo "Unknown option: $1" >&2; return 1 ;;
            *) title="$1"; shift ;;
        esac
    done

    # Read rich-text fields given as files ('-' reads stdin)
    local field file_var path content stdin_field=""
    for field in description design acceptance; do
        file_var="${field}_file"
        path="${!file_var}"
        [[ -z "$path" ]] && continue
        if [[ " $inline_fields " == *" $field "* ]]; then
            echo "Error: use either --$field or --$field-file, not both" >&2
            return 1
        fi
        if [[ "$path" == "-" ]]; then
            if [[ -n "$stdin_field" ]]; then
                echo "Error: only one field can read from stdin" >&2
                return 1
            fi
            if [[ -t 0 ]]; then
                echo "Error: --$field-file - needs piped stdin" >&2
                return 1
            fi
            stdin_field="$field"
            content=$(_read_stripped)
            if [[ -z "$content" ]]; then
                echo "Error: --$field-file - read nothing from stdin" >&2
                return 1
            fi
        elif [[ -d "$path" ]] || ! content=$(_read_stripped "$path" 2>/dev/null); then
            echo "Error: cannot read $field file '$path'" >&2
            return 1
        fi
        printf -v "$field" '%s' "$content"
    done

    # Validate and resolve parent if specified
    if [[ -n "$parent" ]]; then
        local parent_file
        parent_file=$(ticket_path "$parent") || return 1
        parent=$(basename "$parent_file" .md)
    fi

    title="${title:-Untitled}"
    title=$(_strip_trailing_newlines "$title")
    description=$(_strip_trailing_newlines "$description")
    design=$(_strip_trailing_newlines "$design")
    acceptance=$(_strip_trailing_newlines "$acceptance")
    local id
    id=$(generate_id)
    local file="$TICKETS_DIR/${id}.md"
    local now
    now=$(_iso_date)

    # Dry run renders the same bytes to stdout and writes nothing
    if [[ $dry_run -eq 1 ]]; then
        _render_ticket
        return 0
    fi

    ensure_dir
    _render_ticket > "$file"
    echo "$id"
}

# Render a new ticket to stdout from cmd_create's locals
_render_ticket() {
    printf '%s\n' \
        "---" \
        "id: $id" \
        "status: open" \
        "deps: []" \
        "links: []" \
        "created: $now" \
        "type: $issue_type" \
        "priority: $priority"
    [[ -n "$assignee" ]] && printf 'assignee: %s\n' "$assignee"
    [[ -n "$external_ref" ]] && printf 'external-ref: %s\n' "$external_ref"
    [[ -n "$parent" ]] && printf 'parent: %s\n' "$parent"
    if [[ -n "$tags" ]]; then
        printf 'tags: [%s]\n' "${tags//,/, }"
    fi
    printf '%s\n' "---"
    printf '# %s' "$title"
    if [[ -n "$description" ]]; then
        printf '\n\n%s' "$description"
    fi
    if [[ -n "$design" ]]; then
        printf '\n\n## Design\n\n%s' "$design"
    fi
    if [[ -n "$acceptance" ]]; then
        printf '\n\n## Acceptance Criteria\n\n%s' "$acceptance"
    fi
    printf '\n'
}

# Valid statuses
VALID_STATUSES="open in_progress closed"

validate_status() {
    local status="$1"
    for valid in $VALID_STATUSES; do
        [[ "$status" == "$valid" ]] && return 0
    done
    echo "Error: invalid status '$status'. Must be one of: $VALID_STATUSES" >&2
    return 1
}

cmd_status() {
    if [[ $# -lt 2 ]]; then
        echo "Usage: $(basename "$0") status <id> <status>" >&2
        echo "Valid statuses: $VALID_STATUSES" >&2
        return 1
    fi

    local id="$1"
    local status="$2"

    validate_status "$status" || return 1

    local file
    file=$(ticket_path "$id") || return 1

    update_yaml_field "$file" "status" "$status"
    echo "Updated $(basename "$file" .md) -> $status"
}

cmd_start() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: $(basename "$0") start <id>" >&2
        return 1
    fi
    cmd_status "$1" "in_progress"
}

cmd_close() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: $(basename "$0") close <id>" >&2
        return 1
    fi
    cmd_status "$1" "closed"
}

cmd_reopen() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: $(basename "$0") reopen <id>" >&2
        return 1
    fi
    cmd_status "$1" "open"
}

cmd_defer() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: $(basename "$0") defer <id> [--until <date>] [--reason <text>]" >&2
        return 1
    fi

    local id="$1"
    local until="" reason=""
    shift

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --until)
                if [[ $# -lt 2 || "$2" == --* ]]; then
                    echo "Error: --until requires a value" >&2
                    return 1
                fi
                until="$2"
                shift 2
                ;;
            --reason)
                if [[ $# -lt 2 || "$2" == --* ]]; then
                    echo "Error: --reason requires a value" >&2
                    return 1
                fi
                reason="$2"
                shift 2
                ;;
            *)
                echo "Error: unknown defer option '$1'" >&2
                return 1
                ;;
        esac
    done

    if [[ "$reason" == *$'\n'* || "$reason" == *$'\r'* ]]; then
        echo "Error: defer reason must be one line" >&2
        return 1
    fi
    if [[ -n "$until" ]]; then
        validate_defer_date "$until" || return 1
    fi

    local file
    file=$(ticket_path "$id") || return 1
    write_deferral_metadata "$file" "$until" "$reason"
    echo "Deferred $(basename "$file" .md)"
}

cmd_undefer() {
    if [[ $# -ne 1 ]]; then
        echo "Usage: $(basename "$0") undefer <id>" >&2
        return 1
    fi

    local file
    file=$(ticket_path "$1") || return 1
    remove_yaml_fields "$file" deferred defer_until defer_reason
    echo "Undeferred $(basename "$file" .md)"
}

cmd_dep_tree() {
    local full_mode=0
    local root_id=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full) full_mode=1; shift ;;
            *) root_id="$1"; shift ;;
        esac
    done

    if [[ -z "$root_id" ]]; then
        echo "Usage: ticket dep tree [--full] <id>" >&2
        return 1
    fi

    if ! _have_tickets; then
        echo "Error: ticket $root_id not found" >&2
        return 1
    fi

    awk -v root_pattern="$root_id" -v full_mode="$full_mode" '
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; deps=""; in_front=0
        prev_file=FILENAME
    }
    FNR == 1 && $0 == "---" { in_front = 1; next }
    in_front && $0 == "---" { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^deps:/ {
        deps = $2
        gsub(/[\[\] ]/, "", deps)
    }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    function store() {
        if (id != "") {
            statuses[id] = status
            titles[id] = title
            deps_str[id] = deps
            n = split(deps, arr, ",")
            for (i = 1; i <= n; i++) if (arr[i] != "") {
                dep_count[id]++
                dep_list[id, dep_count[id]] = arr[i]
            }
        }
    }

    END {
        if (prev_file) store()
        # Resolve partial ID (an exact match wins over substring matches)
        root = ""
        if (root_pattern in statuses) root = root_pattern
        else for (id in statuses) {
            if (index(id, root_pattern) > 0) {
                if (root != "") {
                    print "Error: ambiguous ID " root_pattern > "/dev/stderr"
                    exit 1
                }
                root = id
            }
        }
        if (root == "") {
            print "Error: ticket " root_pattern " not found" > "/dev/stderr"
            exit 1
        }

        # Find max depths using iterative approach with stack
        stack[1] = root; stack_depth[1] = 0; stack_path[1] = ":"
        sp = 1
        while (sp > 0) {
            id = stack[sp]; depth = stack_depth[sp]; path = stack_path[sp]
            sp--

            if (!(id in statuses)) continue
            if (index(path, ":" id ":") > 0) continue

            if (!(id in max_depth) || depth > max_depth[id]) {
                max_depth[id] = depth
            }

            new_path = path id ":"
            for (i = dep_count[id]; i >= 1; i--) {
                child = dep_list[id, i]
                if (child != "") {
                    sp++
                    stack[sp] = child
                    stack_depth[sp] = depth + 1
                    stack_path[sp] = new_path
                }
            }
        }

        # Compute subtree depths (iterative post-order)
        delete stack; delete stack_depth; delete stack_path
        delete visited
        stack[1] = root; stack_path[1] = ":"; stack_phase[1] = 0
        sp = 1
        while (sp > 0) {
            id = stack[sp]; path = stack_path[sp]; phase = stack_phase[sp]

            if (!(id in statuses) || index(path, ":" id ":") > 0) { sp--; continue }

            if (phase == 0) {
                # First visit: push children
                stack_phase[sp] = 1
                new_path = path id ":"
                for (i = dep_count[id]; i >= 1; i--) {
                    child = dep_list[id, i]
                    if (child != "" && !(child in subtree_depth)) {
                        sp++
                        stack[sp] = child
                        stack_path[sp] = new_path
                        stack_phase[sp] = 0
                    }
                }
            } else {
                # Second visit: compute subtree depth
                max_sub = max_depth[id]
                for (i = 1; i <= dep_count[id]; i++) {
                    child = dep_list[id, i]
                    if (child in subtree_depth && subtree_depth[child] > max_sub) {
                        max_sub = subtree_depth[child]
                    }
                }
                subtree_depth[id] = max_sub
                sp--
            }
        }

        # Print tree (iterative with stack)
        print root " [" statuses[root] "] " titles[root]
        printed[root] = 1

        delete stack
        # Stack entries: id|depth|prefix|connector|path
        # Start with root children
        build_children(root, 0, "", "", ":" root ":")

        while (print_sp > 0) {
            id = print_stack_id[print_sp]
            depth = print_stack_depth[print_sp]
            prefix = print_stack_prefix[print_sp]
            connector = print_stack_conn[print_sp]
            path = print_stack_path[print_sp]
            print_sp--

            if (!(id in statuses)) continue
            if (!full_mode && (id in printed)) continue
            if (index(path, ":" id ":") > 0) continue
            if (!full_mode && depth != max_depth[id]) continue

            print prefix connector id " [" statuses[id] "] " titles[id]
            if (!full_mode) printed[id] = 1

            if (connector == "└── ") new_prefix = prefix "    "
            else new_prefix = prefix "│   "

            build_children(id, depth, new_prefix, connector, path id ":")
        }
    }

    function build_children(id, depth, prefix, connector, path,    i, child, n, arr, sorted, j, tmp, min_idx) {
        # Collect printable children
        n = 0
        for (i = 1; i <= dep_count[id]; i++) {
            child = dep_list[id, i]
            if (child == "") continue
            if (!full_mode && (child in printed)) continue
            if (!(child in max_depth)) continue
            if (!full_mode && depth + 1 != max_depth[child]) continue
            if (index(path, ":" child ":") > 0) continue
            n++
            arr[n] = child
        }
        if (n == 0) return

        # Sort by subtree_depth, then by ticket ID (insertion sort)
        for (i = 2; i <= n; i++) {
            tmp = arr[i]
            j = i - 1
            while (j >= 1 && (subtree_depth[arr[j]] > subtree_depth[tmp] || \
                   (subtree_depth[arr[j]] == subtree_depth[tmp] && arr[j] > tmp))) {
                arr[j + 1] = arr[j]
                j--
            }
            arr[j + 1] = tmp
        }

        # Push to stack in reverse order (so first prints first)
        for (i = n; i >= 1; i--) {
            child = arr[i]
            print_sp++
            print_stack_id[print_sp] = child
            print_stack_depth[print_sp] = depth + 1
            print_stack_prefix[print_sp] = prefix
            if (i == n) print_stack_conn[print_sp] = "└── "
            else print_stack_conn[print_sp] = "├── "
            print_stack_path[print_sp] = path
        }
    }
    ' "$TICKETS_DIR"/*.md 2>/dev/null
}

cmd_dep_cycle() {
    if ! _have_tickets; then
        echo "No dependency cycles found"
        return 0
    fi

    awk '
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; deps=""; in_front=0
        prev_file=FILENAME
    }
    FNR == 1 && $0 == "---" { in_front = 1; next }
    in_front && $0 == "---" { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^deps:/ {
        deps = $2
        gsub(/[\[\] ]/, "", deps)
    }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    function store() {
        if (id != "" && status != "closed") {
            statuses[id] = status
            titles[id] = title
            deps_str[id] = deps
            n = split(deps, arr, ",")
            for (i = 1; i <= n; i++) if (arr[i] != "") {
                dep_count[id]++
                dep_list[id, dep_count[id]] = arr[i]
            }
        }
    }

    # DFS cycle detection
    function dfs(node, path, path_len,    i, child, result) {
        if (!(node in statuses)) return ""
        if (state[node] == 2) return ""  # black - fully visited
        if (state[node] == 1) {
            # gray - found cycle, extract it
            cycle = node
            for (i = path_len; i >= 1; i--) {
                cycle = path[i] " -> " cycle
                if (path[i] == node) break
            }
            return cycle
        }

        state[node] = 1  # gray - visiting
        path[path_len + 1] = node

        for (i = 1; i <= dep_count[node]; i++) {
            child = dep_list[node, i]
            result = dfs(child, path, path_len + 1)
            if (result != "") return result
        }

        state[node] = 2  # black - done
        return ""
    }

    END {
        if (prev_file) store()

        cycle_count = 0
        for (id in statuses) {
            if (state[id] == 0) {
                delete path
                result = dfs(id, path, 0)
                if (result != "") {
                    # Check if this cycle is already found (normalized)
                    # Extract cycle members
                    n = split(result, parts, " -> ")
                    # Normalize: find smallest ID as starting point
                    min_id = parts[1]
                    min_idx = 1
                    for (i = 2; i < n; i++) {  # skip last (duplicate of first)
                        if (parts[i] < min_id) {
                            min_id = parts[i]
                            min_idx = i
                        }
                    }
                    # Build normalized cycle string
                    norm = ""
                    for (i = 0; i < n - 1; i++) {
                        idx = ((min_idx - 1 + i) % (n - 1)) + 1
                        norm = (norm == "") ? parts[idx] : norm "," parts[idx]
                    }
                    # Check if already seen
                    if (!(norm in seen_cycles)) {
                        seen_cycles[norm] = 1
                        cycle_count++
                        cycles[cycle_count] = result
                        cycle_members[cycle_count] = norm
                    }
                }
            }
        }

        if (cycle_count == 0) {
            print "No dependency cycles found"
        } else {
            for (c = 1; c <= cycle_count; c++) {
                if (c > 1) print ""
                print "Cycle " c ": " cycles[c]
                n = split(cycle_members[c], members, ",")
                for (i = 1; i <= n; i++) {
                    id = members[i]
                    printf "  %-8s [%s] %s\n", id, statuses[id], titles[id]
                }
            }
        }
    }
    ' "$TICKETS_DIR"/*.md 2>/dev/null
}

cmd_dep() {
    # Handle subcommands
    if [[ "${1:-}" == "tree" ]]; then
        shift
        cmd_dep_tree "$@"
        return
    fi
    if [[ "${1:-}" == "cycle" ]]; then
        shift
        cmd_dep_cycle "$@"
        return
    fi

    if [[ $# -lt 2 ]]; then
        echo "Usage: ticket dep <id> <dependency-id>" >&2
        echo "       ticket dep tree <id>  - show dependency tree" >&2
        echo "       ticket dep cycle      - find dependency cycles" >&2
        return 1
    fi

    local id="$1"
    local dep_id="$2"
    local file
    file=$(ticket_path "$id") || return 1

    # Verify dependency exists and resolve to full ID
    local dep_file
    dep_file=$(ticket_path "$dep_id") || return 1
    dep_id=$(basename "$dep_file" .md)

    # Get current deps (a missing or empty field counts as []); check first so
    # a malformed ticket reports why instead of being read as having no deps
    check_frontmatter "$file" || return 1
    local current_deps
    current_deps=$(yaml_field "$file" "deps" || true)

    # Add dep if not already present
    if _list_has "$current_deps" "$dep_id"; then
        echo "Dependency already exists"
        return 0
    fi

    update_yaml_field "$file" "deps" "$(_list_add "$current_deps" "$dep_id")"

    echo "Added dependency: $(basename "$file" .md) -> $dep_id"
}

cmd_ready() {
    local assignee_filter="" tag_filter=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -a) _require_value "$1" $# || return 1; assignee_filter="$2"; shift 2 ;;
            --assignee=*) assignee_filter="${1#--assignee=}"; shift ;;
            -T) _require_value "$1" $# || return 1; tag_filter="$2"; shift 2 ;;
            --tag=*) tag_filter="${1#--tag=}"; shift ;;
            *) shift ;;
        esac
    done

    local today
    today=$(_utc_today)

    _have_tickets || return 0

    awk -v assignee_filter="$assignee_filter" -v tag_filter="$tag_filter" -v today="$today" '
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; deps=""; priority=""; assignee=""; tags=""
        deferred=""; defer_until=""; in_front=0
        prev_file=FILENAME
    }
    FNR == 1 && $0 == "---" { in_front = 1; next }
    in_front && $0 == "---" { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^priority:/ { priority = $2 }
    in_front && /^assignee:/ { assignee = $2 }
    in_front && /^tags:/ { tags = $2; gsub(/[\[\] ]/, "", tags) }
    in_front && /^deferred:/ { deferred = $2 }
    in_front && /^defer_until:/ { defer_until = $2 }
    in_front && /^deps:/ {
        deps = $2
        gsub(/[\[\] ]/, "", deps)
    }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    function has_tag(tags_str, tag,    i, n, arr) {
        n = split(tags_str, arr, ",")
        for (i = 1; i <= n; i++) if (arr[i] == tag) return 1
        return 0
    }
    function store() {
        if (id != "") {
            statuses[id] = status
            titles[id] = title
            deps_raw[id] = deps
            priorities[id] = (priority != "") ? priority : 2
            assignees[id] = assignee
            all_tags[id] = tags
            deferred_values[id] = deferred
            defer_until_values[id] = defer_until
        }
    }
    END {
        if (prev_file) store()
        # Find ready tickets: active with all deps closed
        for (id in statuses) {
            status = statuses[id]
            if (status != "open" && status != "in_progress") continue
            if (assignee_filter != "" && assignees[id] != assignee_filter) continue
            if (tag_filter != "" && !has_tag(all_tags[id], tag_filter)) continue
            if (deferred_values[id] == "true" && (defer_until_values[id] == "" || today < defer_until_values[id])) continue

            deps = deps_raw[id]
            ready = 1
            if (deps != "") {
                n = split(deps, arr, ",")
                for (i = 1; i <= n; i++) {
                    dep = arr[i]
                    if (dep != "" && statuses[dep] != "closed") {
                        ready = 0
                        break
                    }
                }
            }
            if (ready) {
                output[++count] = sprintf("%s|%s|%s|%s", priorities[id], id, status, titles[id])
            }
        }

        # Sort by priority, then by id
        for (i = 1; i <= count; i++) {
            for (j = i + 1; j <= count; j++) {
                split(output[i], a, "|")
                split(output[j], b, "|")
                if (a[1] > b[1] || (a[1] == b[1] && a[2] > b[2])) {
                    tmp = output[i]; output[i] = output[j]; output[j] = tmp
                }
            }
        }

        for (i = 1; i <= count; i++) {
            split(output[i], f, "|")
            printf "%-8s [P%s][%s] - %s\n", f[2], f[1], f[3], f[4]
        }
    }
    ' "$TICKETS_DIR"/*.md 2>/dev/null
}

cmd_deferred() {
    if [[ $# -ne 0 ]]; then
        echo "Usage: $(basename "$0") deferred" >&2
        return 1
    fi

    local today
    today=$(_utc_today)

    _have_tickets || return 0

    awk -v today="$today" '
    BEGIN {
        FS=": "
        in_front=0
        squote = sprintf("%c", 39)
        double_squote = squote squote
    }
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; priority=""; deferred=""; defer_until=""; defer_reason=""
        in_front=0
        prev_file=FILENAME
    }
    FNR == 1 && $0 == "---" { in_front = 1; next }
    in_front && $0 == "---" { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^priority:/ { priority = $2 }
    in_front && /^deferred:/ { deferred = $2 }
    in_front && /^defer_until:/ { defer_until = $2 }
    in_front && /^defer_reason:/ {
        defer_reason = $0
        sub(/^defer_reason:[[:space:]]*/, "", defer_reason)
        defer_reason = yaml_single_quote_decode(defer_reason)
    }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    function yaml_single_quote_decode(value) {
        if (length(value) >= 2 && substr(value, 1, 1) == squote && substr(value, length(value), 1) == squote) {
            value = substr(value, 2, length(value) - 2)
            gsub(double_squote, squote, value)
        }
        return value
    }
    function store() {
        if (id != "") {
            statuses[id] = status
            titles[id] = title
            priorities[id] = (priority != "") ? priority : 2
            deferred_values[id] = deferred
            defer_until_values[id] = defer_until
            defer_reason_values[id] = defer_reason
        }
    }
    END {
        if (prev_file) store()
        for (id in statuses) {
            status = statuses[id]
            if (status != "open" && status != "in_progress") continue
            if (deferred_values[id] != "true") continue
            if (defer_until_values[id] != "" && !(today < defer_until_values[id])) continue
            output[++count] = priorities[id] "|" id
        }

        for (i = 1; i <= count; i++) {
            for (j = i + 1; j <= count; j++) {
                split(output[i], a, "|")
                split(output[j], b, "|")
                if (a[1] > b[1] || (a[1] == b[1] && a[2] > b[2])) {
                    tmp = output[i]; output[i] = output[j]; output[j] = tmp
                }
            }
        }

        for (i = 1; i <= count; i++) {
            split(output[i], fields, "|")
            id = fields[2]
            annotation = "[deferred=true"
            if (defer_until_values[id] != "") annotation = annotation "; defer_until=" defer_until_values[id]
            if (defer_reason_values[id] != "") annotation = annotation "; defer_reason=" defer_reason_values[id]
            annotation = annotation "]"
            printf "%-8s [P%s][%s] - %s %s\n", id, fields[1], statuses[id], titles[id], annotation
        }
    }
    ' "$TICKETS_DIR"/*.md 2>/dev/null
}

cmd_closed() {
    local limit=20 assignee_filter="" tag_filter=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --limit=*) limit="${1#--limit=}"; shift ;;
            --limit) _require_value "$1" $# || return 1; limit="$2"; shift 2 ;;
            -a) _require_value "$1" $# || return 1; assignee_filter="$2"; shift 2 ;;
            --assignee=*) assignee_filter="${1#--assignee=}"; shift ;;
            -T) _require_value "$1" $# || return 1; tag_filter="$2"; shift 2 ;;
            --tag=*) tag_filter="${1#--tag=}"; shift ;;
            *) shift ;;
        esac
    done

    if [[ ! "$limit" =~ ^[0-9]+$ ]]; then
        echo "Error: --limit must be a whole number, got '$limit'" >&2
        return 1
    fi
    _have_tickets || return 0

    # Scan the most recent files (at least 100, or the limit if larger),
    # filter closed, then limit output. awk drains its input, so ls never
    # gets SIGPIPE under pipefail, and the command substitution keeps an ls
    # failure (such as "Argument list too long") visible.
    local listing
    if ! listing=$(ls -t "$TICKETS_DIR"/*.md | awk -v limit="$limit" 'NR <= 100 || NR <= limit + 0'); then
        echo "Error: could not list tickets in $TICKETS_DIR" >&2
        return 1
    fi

    # One path per line into an array (not xargs, which splits on spaces)
    local -a files=()
    local path
    while IFS= read -r path; do
        if [[ -n "$path" ]]; then
            files+=("$path")
        fi
    done <<< "$listing"
    [[ ${#files[@]} -gt 0 ]] || return 0

    awk -v assignee_filter="$assignee_filter" -v tag_filter="$tag_filter" '
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) emit()
        id=""; status=""; title=""; assignee=""; tags=""; in_front=0
        prev_file=FILENAME
    }
    FNR == 1 && $0 == "---" { in_front = 1; next }
    in_front && $0 == "---" { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^assignee:/ { assignee = $2 }
    in_front && /^tags:/ { tags = $2; gsub(/[\[\] ]/, "", tags) }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    function has_tag(tags_str, tag,    i, n, arr) {
        n = split(tags_str, arr, ",")
        for (i = 1; i <= n; i++) if (arr[i] == tag) return 1
        return 0
    }
    function emit() {
        if (id != "" && (status == "closed" || status == "done") && (assignee_filter == "" || assignee == assignee_filter) && (tag_filter == "" || has_tag(tags, tag_filter))) {
            output[++count] = sprintf("%-8s [%s] - %s", id, status, title)
        }
    }
    END {
        if (prev_file) emit()
        for (i = 1; i <= count; i++) print output[i]
    }
    ' "${files[@]}" | awk -v limit="$limit" 'NR <= limit'
}

cmd_blocked() {
