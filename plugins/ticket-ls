#!/usr/bin/env bash
# tk-plugin: List tickets with optional filters
# tk-plugin-version: 1.1.1
set -euo pipefail

status_filter="" assignee_filter="" tag_filter=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --status=*) status_filter="${1#--status=}"; shift ;;
        -a) assignee_filter="$2"; shift 2 ;;
        --assignee=*) assignee_filter="${1#--assignee=}"; shift ;;
        -T) tag_filter="$2"; shift 2 ;;
        --tag=*) tag_filter="${1#--tag=}"; shift ;;
        *) shift ;;
    esac
done

awk -v status_filter="$status_filter" -v assignee_filter="$assignee_filter" -v tag_filter="$tag_filter" '
BEGIN {
    FS=": "
    in_front=0
    squote = sprintf("%c", 39)
    double_squote = squote squote
}
FNR==1 {
    if (prev_file) emit()
    id=""; status=""; title=""; deps=""; assignee=""; tags=""
    deferred=""; defer_until=""; defer_reason=""
    deferred_seen=0; defer_until_seen=0; defer_reason_seen=0; in_front=0
    prev_file=FILENAME
}
/^---$/ { in_front = !in_front; next }
in_front && /^id:/ { id = $2 }
in_front && /^status:/ { status = $2 }
in_front && /^assignee:/ { assignee = $2 }
in_front && /^tags:/ { tags = $2; gsub(/[\[\] ]/, "", tags) }
in_front && /^deferred:/ { deferred = $2; deferred_seen=1 }
in_front && /^defer_until:/ { defer_until = $2; defer_until_seen=1 }
in_front && /^defer_reason:/ {
    defer_reason = $0
    sub(/^defer_reason:[[:space:]]*/, "", defer_reason)
    defer_reason = yaml_single_quote_decode(defer_reason)
    defer_reason_seen=1
}
in_front && /^deps:/ {
    deps = $2
    gsub(/[\[\] ]/, "", deps)
}
!in_front && /^# / && title == "" { title = substr($0, 3) }
END { if (prev_file) emit() }
function has_tag(tags_str, tag,    i, n, arr) {
    n = split(tags_str, arr, ",")
    for (i = 1; i <= n; i++) if (arr[i] == tag) return 1
    return 0
}
function yaml_single_quote_decode(value) {
    if (length(value) >= 2 && substr(value, 1, 1) == squote && substr(value, length(value), 1) == squote) {
        value = substr(value, 2, length(value) - 2)
        gsub(double_squote, squote, value)
    }
    return value
}
function emit() {
    if (id != "" && (status_filter == "" || status == status_filter) && (assignee_filter == "" || assignee == assignee_filter) && (tag_filter == "" || has_tag(tags, tag_filter))) {
        deps_display = (deps != "") ? "[" deps "]" : "[]"
        gsub(/,/, ", ", deps_display)
        dep_str = (deps_display != "[]") ? " <- " deps_display : ""
        metadata = ""
        if (deferred_seen) metadata = "deferred=" deferred
        if (defer_until_seen) metadata = metadata (metadata != "" ? "; " : "") "defer_until=" defer_until
        if (defer_reason_seen) metadata = metadata (metadata != "" ? "; " : "") "defer_reason=" defer_reason
        defer_str = (metadata != "") ? " [" metadata "]" : ""
        printf "%-8s [%s] - %s%s%s\n", id, status, title, dep_str, defer_str
    }
}
' "$TICKETS_DIR"/*.md 2>/dev/null
